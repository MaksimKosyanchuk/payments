PORT=3003
OTEL_EXPORTER_OTLP_ENDPOINT=
DATABASE_URL=postgresql://notifications:notifications@localhost:5435/notifications?schema=public
REDIS_URL=redis://localhost:6379
PAYMENTS_EVENTS_STREAM=payments.events
# Same Redis as payments — reads transfer:parties:{id} for WS subscribe ACL
LEDGER_EVENTS_STREAM=ledger.events
# set true to also consume ledger.events
CONSUME_LEDGER_EVENTS=false
REDIS_CONSUMER_GROUP=notifications
REDIS_CONSUMER_NAME=notifications-1
# Must match ledger-service JWT_ACCESS_SECRET
JWT_ACCESS_SECRET=change-me-access
