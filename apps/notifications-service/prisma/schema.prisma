// notifications-service — activity feed + idempotent event consumer (no money)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivityItem {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  payload   Json
  eventId   String   @unique
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([type])
  @@map("activity_items")
}

/// Consumer dedup — never process the same broker event twice.
model ProcessedEvent {
  eventId     String   @id
  type        String?
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@map("processed_events")
}
