PORT=3002
DATABASE_URL=postgresql://payments:payments@localhost:5434/payments?schema=public
LEDGER_SERVICE_URL=http://localhost:3001
# Must match ledger-service LEDGER_SERVICE_API_KEY
LEDGER_SERVICE_API_KEY=change-me-ledger-service
REDIS_URL=redis://localhost:6379
PAYMENTS_EVENTS_STREAM=payments.events
# Redis hash transfer:parties:{transferId} = initiatorId + recipientOwnerId (WS subscribe ACL)
JWT_ACCESS_SECRET=change-me-access
LEDGER_CIRCUIT_FAILURES=5
LEDGER_CIRCUIT_COOLDOWN_MS=30000
# Mock FX endpoint (self by default) + poll every 10s via FxRefreshWorker
FX_RATES_URL=http://127.0.0.1:3002/fx/rates
FX_REFRESH_ENABLED=true
# Must be > refresh interval (10s)
FX_RATE_TTL_MS=60000
